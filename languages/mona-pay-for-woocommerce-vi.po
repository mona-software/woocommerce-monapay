msgstr "Số tài khoản ảo đầy đủ đã nối ACB. Lưu trường này để bật nút tạo giao dịch thử 10.000 VND."

#: includes/class-wc-gateway-monapay.php:156
msgid "Automatic confirmation webhook"
msgstr "Webhook tự xác nhận"

#: includes/class-wc-gateway-monapay.php:158
msgid ""
"HMAC-SHA256 makes sure only genuine webhooks from MONA Pay are accepted."
msgstr "Dùng HMAC-SHA256 để chỉ chấp nhận webhook thật từ MONA Pay."

