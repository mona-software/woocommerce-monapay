#: includes/class-wc-gateway-monapay.php:78
msgid "MONA Pay connection"
msgstr "Kết nối MONA Pay"

#: includes/class-wc-gateway-monapay.php:80
msgid "Go to my.monapay.vn → API Keys → Create key after you sign up."
msgstr "Vào my.monapay.vn → API Keys → Tạo key, hoặc dùng khối “Đưa cho AI” sau khi đăng ký."

#: includes/class-wc-gateway-monapay.php:86
msgid "Root URL of the MONA Pay API, without /api/v1."
msgstr "URL gốc của MONA Pay API, không thêm /api/v1."

#: includes/class-wc-gateway-monapay.php:92
msgid "Find it at my.monapay.vn → API Keys → Create key."
msgstr "Lấy tại my.monapay.vn → API Keys → Tạo key."

#: includes/class-wc-gateway-monapay.php:98
msgid ""
"The secret is shown only once when the key is created. The plugin uses it to "
"get a token and to send the X-Client-Secret header."
msgstr "Secret chỉ hiển thị một lần khi tạo key; plugin dùng để lấy token và gửi header X-Client-Secret."

#: includes/class-wc-gateway-monapay.php:102
