msgstr "Secret chữ ký quay về"

#. translators: %s: MONA Pay hosted checkout documentation URL.
#: includes/class-wc-gateway-monapay.php:106
#, php-format
msgid ""
"Find it in the MONA Pay dashboard → Settings → Payment page. <a href=\"%s\" "
